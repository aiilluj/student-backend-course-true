    {
      "name": "GET Books Search",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Все книги содержат 'Гарри'\", function () {\r\n    const jsonData = pm.response.json();\r\n    jsonData.books.forEach(book => {\r\n        pm.expect(book.title.toLowerCase()).to.include('гарри');\r\n    });\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
