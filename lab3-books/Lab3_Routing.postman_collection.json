          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 404 Not Found\", function () {\r\n    pm.response.to.have.status(404);\r\n});\r\n\r\npm.test(\"Ответ содержит error\", function () {\r\n    const jsonData = pm.response.json();\r\n    pm.expect(jsonData).to.have.property('error');\r\n});"
            ]
          }
        }
